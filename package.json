    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.18.1",
    "multer": "^2.4.0",
    "mysql2": "^3.16.2",
    "nodemailer": "^7.0.13",
    "uuid": "^13.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
