{
  "name": "app",
  "version": "1.0.0",
  "description": "Real estate app",
  "main": "server.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "npm run migrate && npm run seed && node server.js",
    "dev": "nodemon server.js",
    "build": "npm install && npm install --prefix clients && npm run build --prefix clients",
    "migrate": "npx db-migrate up",
    "migrate:down": "npx db-migrate down",
    "start:prod": "npm run migrate && npm run seed && node server.js",
    "seed": "node app/database/seed.js"
  },
